# Example environment variables for HubSpot ROI Analyzer
# Copy to .env and fill in real values (do NOT commit secrets to git)

# Clerk Authentication
CLERK_SECRET_KEY=your_clerk_secret_key
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key

# Supabase / Postgres
DATABASE_URL=postgres://USER:PASS@HOST:5432/DBNAME
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server
PORT=4000
NODE_ENV=development

# Gemini / GenAI
GEMINI_API_KEY=your_gemini_api_key

# HubSpot (OAuth tokens as needed)
HUBSPOT_CLIENT_ID=your_hubspot_client_id
HUBSPOT_CLIENT_SECRET=your_hubspot_client_secret
HUBSPOT_REFRESH_TOKEN=your_hubspot_refresh_token
HUBSPOT_ACCESS_TOKEN=your_hubspot_access_token

# GA4
GA4_ACCESS_TOKEN=your_ga4_access_token
GA4_PROPERTY_ID=your_ga4_property_id
GA4_MEASUREMENT_ID=G-XXXXXXXX
GA4_API_SECRET=your_ga4_api_secret

# Scheduler
SCHEDULER_TZ=GMT
SCHEDULER_TOKEN=your_scheduler_token_optional

# Notifications (Smart user engagement & retention)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=noreply@foundry.io
